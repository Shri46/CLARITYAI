# ─────────────────────────────────────────────
#  CLARITY AI — Backend Environment Variables
#  Copy this file to .env and fill in values
#  Never commit .env to Git!
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → your cluster → Connect → Drivers
